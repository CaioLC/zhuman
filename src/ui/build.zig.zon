    .minimum_zig_version = "0.15.2",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "root.zig",
        "node.zig",
        "ctx.zig",
        "cache.zig",
        "focus.zig",

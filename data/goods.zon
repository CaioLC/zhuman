// The capital goods — recipes for the BUILD shelf, plus the two tools only the passerby
// carries. The grammar is described in `src/README.md` ("The authored roster"). `requires`
// is the build price in body and time; `input` lines are the build order (`once`) or cycle
// upkeep (`per = .day`); day outputs are rates realized only on generator collection. What
// owning a good does is its `effects`, from a fixed vocabulary; `family` + `rank` say which
// tool a better one supersedes; `needs` names the verb a modifier works on. `copy` is the
// player's words.
//
// Crude goods are what one person can build in Act I. Manufactured unlockers are acquired
// from the passerby instead; the remaining manufactured records stay catalogued for later
// progression but never enter the Act I BUILD shelf. A generator's hours accumulate without
// occupying the body; its low energy price and complete cycle settle only when collected.
.{
    // —— Manufactured unlockers: passerby-only in Act I ———————————————————————————————
    .{
        .id = "fish_rod",
        .name = "Fishing rod",
        .buildable = false,
        .family = .{ .name = "fishing", .rank = 1 },
        .effects = .{
            .{ .grant = "fish" },
        },
        .copy = .{
            .effect = "you can fish",
            .short = "can fish",
            .built = "You built a fish rod. Fishing is now possible.",
        },
    },
    .{
        .id = "hatchet",
        .name = "Hatchet",
        .buildable = false,
        .family = .{ .name = "chopping", .rank = 1 },
        .effects = .{
            .{ .grant = "chop_wood" },
        },
        .copy = .{
            .effect = "you can split wood",
            .short = "can split wood",
            .built = "You built a hatchet. You can split wood now.",
        },
    },
    // Wire snares accumulate a trap round without occupying the body. Bait and yield are
    // authored per cycle-day and settle together only when collected.
    .{
        .id = "wire_snares",
        .name = "Wire snares",
        .tier = .crude,
        .requires = .{ .energy = 2.0, .hours = 8.0 },
        .generator = .{ .energy = 1.0, .hours = 24.0, .label = "Check traps" },
        .input = .{
            .{ .item = "materials", .n = 5.0 },
            .{ .item = "materials", .n = 1.0, .per = .day },
        },
        .output = .{
            .{ .item = "food", .n = 3.0, .kind = .poisson, .per = .day },
        },
        .copy = .{
            .effect = "readies game to collect",
            .short = "traps game",
            .built = "You set wire snares. They will ready game without occupying you.",
        },
    },
    .{
        .id = "spear",
        .name = "Spear",
        .tier = .crude,
        .requires = .{ .energy = 5.0, .hours = 6.0 },
        .input = .{.{ .item = "materials", .n = 10.0 }},
        .effects = .{
            .{ .grant = "hunt" },
        },
        .copy = .{
            .effect = "you can hunt",
            .short = "can hunt",
            .built = "A sharp, long stick. You can hunt now.",
        },
    },
    // —— Modifiers: a margin on a verb you already have ——————————————————————————————————
    .{
        .id = "sandals",
        .name = "Sandals",
        .tier = .crude,
        .requires = .{ .energy = 1.0, .hours = 6.0 },
        .input = .{.{ .item = "materials", .n = 3.0 }},
        .effects = .{
            .{ .scale = .{ .target = "forage", .stat = .energy, .by = 0.85 } },
        },
        .copy = .{
            .effect = "foraging costs less",
            .short = "forage costs less",
            .built = "You bound sandals from bark. Foraging costs a little less.",
        },
    },
    .{
        .id = "work_gloves",
        .name = "Work gloves",
        .tier = .manufactured,
        .requires = .{ .energy = 1.0, .hours = 50.0 },
        .input = .{.{ .item = "materials", .n = 24.0 }},
        .needs = .{"chop_wood"},
        .effects = .{
            .{ .scale = .{ .target = "chop_wood", .stat = .energy, .by = 0.75 } },
        },
        .copy = .{
            .effect = "splitting wood costs less",
            .short = "split wood costs less",
            .built = "You stitched work gloves. Splitting wood costs less.",
        },
    },
    .{
        .id = "bicycle",
        .name = "Bicycle",
        .tier = .manufactured,
        .requires = .{ .energy = 2.0, .hours = 140.0 },
        .input = .{.{ .item = "materials", .n = 280.0 }},
        .effects = .{
            .{ .scale = .{ .target = "forage", .stat = .energy, .by = 0.6 } },
            .{ .scale = .{ .target = "scavenge", .stat = .energy, .by = 0.6 } },
        },
        .copy = .{
            .effect = "roaming costs less",
            .short = "roaming costs less",
            .built = "You rebuilt a bicycle. Distance got cheap.",
        },
    },
    .{
        .id = "cookpot",
        .name = "Cookpot",
        .tier = .manufactured,
        .requires = .{ .energy = 2.0, .hours = 80.0 },
        .input = .{.{ .item = "materials", .n = 56.0 }},
        .effects = .{
            .{ .food_quality = 1 },
        },
        .copy = .{
            .effect = "food feeds you further",
            .short = "food feeds further",
            .built = "You built a cookpot. Cooked food feeds you further.",
        },
    },
    .{
        .id = "root_cellar",
        .name = "Root cellar",
        .tier = .crude,
        .requires = .{ .energy = 4.0, .hours = 12.0 },
        .input = .{.{ .item = "materials", .n = 10.0 }},
        .effects = .{
            .{ .spoil_scale = 0.5 },
        },
        .copy = .{
            .effect = "food keeps twice as long",
            .short = "food keeps 2×",
            .built = "You dug a root cellar. Food keeps twice as long.",
        },
    },
    // The Act One capstone and the Act II teaser: the first substitution of external energy
    // for muscle. Splitting wood stops pricing the body and starts pricing fuel.
    .{
        .id = "chainsaw",
        .name = "Chainsaw",
        .tier = .manufactured,
        .requires = .{ .energy = 3.0, .hours = 300.0 },
        .input = .{.{ .item = "materials", .n = 480.0 }},
        .needs = .{"chop_wood"},
        .effects = .{
            .{ .scale = .{ .target = "chop_wood", .stat = .energy, .by = 0.3 } },
            .{ .add = .{ .target = "chop_wood", .stat = .{ .input = "materials" }, .by = 1.0 } },
            .{ .scale = .{ .target = "chop_wood", .stat = .{ .output = "materials" }, .by = 2.5 } },
        },
        .copy = .{
            .effect = "fuel does the work, not you",
            .short = "fuel does the work",
            .built = "You got a chainsaw running. The engine works, not your back.",
        },
    },

    // —— Health goods: capacity capital — each raises the vigor ceiling ——————————————————
    .{
        .id = "leaf_bed",
        .name = "Leaf bed",

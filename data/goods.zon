            .{ .item = "materials", .n = 0.1, .per = .day },
        },
        .output = .{
            .{ .item = "food", .n = 0.5, .kind = .uniform, .per = .day },
        },
        .copy = .{
            .effect = "grows food on its own",
            .short = "grows food",
            .built = "You planted a garden bed. It grows without you.",
        },
    },
    .{
        .id = "chicken_coop",
        .name = "Chicken coop",
        .tier = .manufactured,
        .requires = .{ .energy = 3.0, .hours = 200.0 },
        .generator = .{ .energy = 0.5, .hours = 24.0 },
        .input = .{
            .{ .item = "materials", .n = 144.0 },
            .{ .item = "materials", .n = 0.3, .per = .day },
        },
        .output = .{
            .{ .item = "food", .n = 2.5, .kind = .poisson, .per = .day },
        },
        .copy = .{
            .effect = "the hens lay for you",
            .short = "hens lay food",
            .built = "You raised a chicken coop. The hens lay without you.",
        },
    },

    // —— Shelter: the roof that ends Act I ————————————————————————————————————————————————
    // `unlock` is what it asks of the builder (absolute current vigor, a larder, goods already
    // owned) as against `input`, which is what the build spends.
    .{
        .id = "shelter",
        .name = "Shelter",
        .tier = .crude,
        .requires = .{ .energy = 12.0, .hours = 144.0 },
        .input = .{.{ .item = "materials", .n = 60.0 }},
        .unlock = .{ .vigor_abs = 15.0, .food = 12.0, .goods = 5 },
        .capacity = 4,
        .milestone = .act_one,
        .copy = .{
            .effect = "room here for four",
            .short = "room for four",
            .built = "You raised a shelter. There is room here for others.",
        },
    },

    // —— Traded only: the passerby's rank-2 tools. A family's verb takes the stats of the
    // best rank owned; losing the better tool restores the next-best exactly. —————————————
    .{
        .id = "fish_net",
        .name = "Fishing net",
        .buildable = false,
        .family = .{ .name = "fishing", .rank = 2 },
        .effects = .{
            .{ .grant = "fish" },
            .{ .scale = .{ .target = "fish", .stat = .energy, .by = 0.7 } },
            .{ .scale = .{ .target = "fish", .stat = .{ .output = "food" }, .by = 1.5 } },
        },
        .copy = .{
            .effect = "fishing costs less and catches more",
            .short = "fish better",
        },
    },
    .{
        .id = "hand_axe",
        .name = "Hand axe",
        .buildable = false,
        .family = .{ .name = "chopping", .rank = 2 },
        .effects = .{
            .{ .grant = "chop_wood" },
            .{ .scale = .{ .target = "chop_wood", .stat = .energy, .by = 0.7 } },
            .{ .scale = .{ .target = "chop_wood", .stat = .{ .output = "materials" }, .by = 1.4 } },
        },
        .copy = .{
            .effect = "splitting wood costs less and yields more",
            .short = "split wood better",
        },
    },

    // —— Act II infrastructure (act = 2) ————————————————————————————————————————————————
    // The fifty population-scale recipes. Each carries `.act = 2` so the Act I surfaces skip
    // it; most wait on a research tile through `tech` (an id from `data/technologies.zon`),
    // offered only once that tile reads researched. A recipe with no `tech` is open from the
    // curtain. Intermediates (worked stone, boards, brick, cloth) output a lot of themselves;
    // generators grant an Act II verb or run a day line; the rest are capital that is simply
    // owned. Items name only the `Resource` enum. Costs follow the prototype's 50-recipe
    // BUILD fixture, converted to lines; the three openers (firepit, spring well, lean-to)
    // keep their original shape.

    // —— Open from the curtain: no tech gate ——————————————————————————————————————————————
    .{
        .id = "firepit",
        .name = "Firepit",
        .act = 2,
        .tier = .crude,
        .requires = .{ .energy = 4.0, .hours = 8.0 },
        .input = .{.{ .item = "biomass", .n = 8.0 }},
        .effects = .{
            .{ .grant = "burn_charcoal" },
        },
        .copy = .{
            .effect = "converts biomass to fuel",
            .short = "makes fuel",

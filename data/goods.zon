    .{
        .id = "medicinal_herb_bed",
        .name = "Medicinal herb bed",
        .tier = .crude,
        .requires = .{ .energy = 3.0, .hours = 12.0 },
        .input = .{.{ .item = "materials", .n = 10.0 }},
        .generator = .{ .energy = 0.25, .hours = 48.0, .vigor = 1.5 },
        .copy = .{
            .effect = "readies a small vigor remedy",
            .short = "grows remedies",
            .built = "You planted medicinal herbs. A small remedy will mature every two days.",
        },
    },

    // —— Generators: passive cycles collected by the player; day lines are rates —————————
    .{
        .id = "garden_bed",
        .name = "Garden bed",
        .tier = .crude,
        .requires = .{ .energy = 8.0, .hours = 16.0 },

    .{
        .id = "forge_parts",
        .name = "Forge parts",
        .act = 2,
        .requires = .{ .energy = 3.0, .hours = 7.0 },
        .input = .{
            .{ .item = "metal", .n = 2.0 },
            .{ .item = "fuel", .n = 2.0 },
        },
        .output = .{
            .{ .item = "metal", .n = 3.0, .kind = .uniform },
        },
    },
    // Tend garden (the settlement's bed): the Act II garden bed's two-day crop.
    .{
        .id = "tend_garden_two",
        .name = "Tend garden",
        .act = 2,
        .generator = true,
        .requires = .{ .energy = 0.5, .hours = 48.0 },
        .input = .{
            .{ .item = "biomass", .n = 0.2 },

    },
    .{
        .id = "bake_bread",
        .name = "Bake bread",
        .act = 2,
        .tech = "granary",
        .requires = .{ .energy = 1.8, .hours = 4.0 },
        .input = .{
            .{ .item = "food", .n = 2.0 },
            .{ .item = "fuel", .n = 1.0 },
        },
        .output = .{
            .{ .item = "food", .n = 5.0, .kind = .uniform },

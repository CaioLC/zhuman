// The verbs: the labor an agent performs and the generators it collects. The grammar is
// described in `src/README.md` ("The authored roster"). `requires` is everything a verb
// demands: the energy, paid at begin and strictly below current vigor; the hours it takes; an
// amount of each resource it spends, paid at begin and spendable to zero; and its gates — a
// researched `tech`, `any` of a list of goods and verbs, `all` of a list. A verb with a gate is
// held while every gate passes; a verb without one is held only as an agent's own, the
// starting verbs. `output` is what it draws at completion: a distribution and its scale per
// resource (`.fixed` is exact; the other kinds draw, and the spread is the risk), and `vigor`
// restored directly. A `generator` accumulates its hours without occupying the body, and pays
// its `requires` and draws its `output` at each collection. Ids are plain and share one space
// with goods. The order here is the ACTIONS surface's reading order.
.{
    // Forage: glean the greenbelt. The safe calorie baseline: normal, steady. A starting verb.
    .{
        .id = "forage",
        .name = "Forage",
        .requires = .{ .energy = 1.7, .hours = 4.0 },
        .output = .{ .food = .{ .normal = 1.8 } },
    },
    // Scavenge: pick through the derelict edge of town. The bare-handed materials source that
    // bootstraps the first tool: mostly scraps, sometimes a jackpot or a forgotten can. A
    // starting verb.
    .{
        .id = "scavenge",
        .name = "Scavenge",
        .requires = .{ .energy = 2.0, .hours = 5.0 },
        .output = .{ .food = .{ .exponential = 0.5 }, .biomass = .{ .exponential = 2.5 } },
    },
    // Split wood: held with a hatchet or a hand axe. The materials engine: about twice
    // scavenging's materials per energy, an even uniform spread.
    .{
        .id = "chop_wood",
        .name = "Split wood",
        .requires = .{ .energy = 4.0, .hours = 5.0, .any = .{ "hatchet", "hand_axe" } },
        .output = .{ .biomass = .{ .uniform = 8.0 } },
    },
    // Fish: held with a fishing rod or a net. The best food per hour and per energy a lone
    // actor has, the yield of a bought tool; poisson-lumpy, so it wants a larder buffer under
    // the metabolism.
    .{
        .id = "fish",
        .name = "Fish",
        .requires = .{ .energy = 2.0, .hours = 6.0, .any = .{ "fish_rod", "fish_net" } },
        .output = .{ .food = .{ .poisson = 4.5 } },
    },
    // Check traps: the wire snares' daily round, a generator. Passive and baited: collecting
    // pays the energy and the bait and draws a lumpy catch.
    .{
        .id = "check_traps",
        .name = "Check traps",
        .generator = true,
        .requires = .{ .energy = 2.0, .hours = 24.0, .biomass = 2.0, .all = .{"wire_snares"} },
        .output = .{ .food = .{ .exponential = 1.5 } },
    },
    // Hunt: held with the crude spear. The biggest single lump, but less food per hour and per
    // energy than Fish: a home-made tool against a bought one. Costly in energy, so it wants a
    // vigor reserve above it. The bait is paid at begin.
    .{
        .id = "hunt",
        .name = "Hunt",
        .requires = .{ .energy = 4.0, .hours = 8.0, .biomass = 1.0, .all = .{"spear"} },
        .output = .{ .food = .{ .poisson = 5.5 } },
    },
    // Tend garden: the garden bed's two-day crop, a generator. Slow, steady and cheap.
    .{
        .id = "tend_garden",
        .name = "Tend garden",
        .generator = true,
        .requires = .{ .energy = 2.0, .hours = 72.0, .biomass = 0.2, .all = .{"garden_bed"} },
        .output = .{ .food = .{ .uniform = 1.5 } },
    },
    // Gather remedy: the medicinal herb bed's remedy, a generator. Vigor restored directly.
    .{
        .id = "gather_remedy",
        .name = "Gather remedy",
        .generator = true,
        .requires = .{ .energy = 0.25, .hours = 48.0, .all = .{"medicinal_herb_bed"} },
        .output = .{ .vigor = 1.5 },
    },
    // Collect eggs: the chicken coop's daily lay, a generator. The late-act food staple.
    .{
        .id = "collect_eggs",
        .name = "Collect eggs",
        .generator = true,
        .requires = .{ .energy = 0.5, .hours = 24.0, .biomass = 0.3, .all = .{"chicken_coop"} },
        .output = .{ .food = .{ .poisson = 2.5 } },
    },

    // —— Act II population-scale actions (act = 2) ——————————————————————————————————————
    // The twenty verbs the settlement works at scale. The first five mirror the Act I labor
    // in the Act II resource space (the same Biomass stock sheds its Materials cover);
    // the rest are the broader production the research board opens. A verb is held while its
    // gate passes: owning the good it names (the firepit, the spring well, the forge) or its
    // `tech`, the technology that establishes it, once researched. Amounts name only the
    // `Resource` enum — tools/comfort/transport products settle into the nearest stock (metal
    // for tooling, food for comfort/care, biomass for carried freight). The order is the Act II
    // ACTIONS browser's authored order.
    .{
        .id = "draw_water",
        .name = "Draw water",
        .act = 2,
        .requires = .{ .energy = 1.2, .hours = 3.0, .all = .{"spring_well"} },
        .output = .{ .water = .{ .normal = 4.0 } },
    },
    .{
        .id = "tend_gardens",
        .name = "Tend gardens",
        .act = 2,
        .requires = .{ .energy = 1.5, .hours = 4.0, .water = 1.0, .tech = "field_cultivation" },
        .output = .{ .food = .{ .uniform = 4.0 } },
    },
    .{
        .id = "gather_clay",
        .name = "Gather clay",
        .act = 2,
        .requires = .{ .energy = 2.1, .hours = 5.0, .water = 1.0, .tech = "quarry_pit" },
        .output = .{ .minerals = .{ .normal = 4.0 } },
    },
    .{
        .id = "burn_charcoal",
        .name = "Burn charcoal",
        .act = 2,
        .requires = .{ .energy = 1.3, .hours = 7.0, .biomass = 3.0, .all = .{"firepit"} },
        .output = .{ .fuel = .{ .uniform = 4.0 } },
    },
    .{
        .id = "quarry_stone",
        .name = "Quarry stone",
        .act = 2,
        .requires = .{ .energy = 3.2, .hours = 6.0, .tech = "stoneworks" },
        .output = .{ .minerals = .{ .poisson = 3.5 } },
    },
    .{
        .id = "repair_tools",
        .name = "Repair tools",
        .act = 2,
        .requires = .{ .energy = 1.6, .hours = 3.0, .biomass = 2.0, .tech = "smithy" },
        .output = .{ .metal = .{ .normal = 1.0 } },
    },
    .{
        .id = "carry_freight",
        .name = "Carry freight",
        .act = 2,
        .requires = .{ .energy = 2.4, .hours = 5.0, .food = 1.0, .tech = "woodcutting" },
        .output = .{ .biomass = .{ .uniform = 2.0 } },
    },
    .{
        .id = "fell_timber",
        .name = "Fell timber",
        .act = 2,
        .requires = .{ .energy = 3.0, .hours = 6.0, .tech = "woodcutting" },
        .output = .{ .biomass = .{ .normal = 7.0 } },
    },
    .{
        .id = "harvest_reeds",
        .name = "Harvest reeds",
        .act = 2,
        .requires = .{ .energy = 1.4, .hours = 4.0, .water = 1.0, .tech = "loom_ropewalk" },
        .output = .{ .biomass = .{ .exponential = 4.0 } },
    },
    .{
        .id = "smelt_ore",
        .name = "Smelt ore",
        .act = 2,
        .requires = .{
            .energy = 3.0,
            .hours = 6.0,
            .fuel = 2.0,
            .minerals = 2.0,
            .tech = "smelting_hearth",
        },
        .output = .{ .metal = .{ .fixed = 2.0 } },
    },
    .{
        .id = "mine_ore",
        .name = "Mine ore",
        .act = 2,
        .requires = .{ .energy = 3.5, .hours = 8.0, .metal = 1.0, .tech = "surface_ore" },
        .output = .{ .metal = .{ .poisson = 2.0 } },
    },
    .{
        .id = "smelt_metal",
        .name = "Smelt metal",
        .act = 2,
        .requires = .{
            .energy = 2.8,
            .hours = 7.0,
            .fuel = 2.0,
            .minerals = 2.0,
            .tech = "iron_smelting",
        },
        .output = .{ .metal = .{ .uniform = 3.0 } },
    },
    .{
        .id = "mill_grain",
        .name = "Mill grain",
        .act = 2,
        .requires = .{ .energy = 2.0, .hours = 5.0, .food = 2.0, .tech = "water_wheel" },
        .output = .{ .food = .{ .normal = 5.0 } },
    },
    .{
        .id = "bake_bread",
        .name = "Bake bread",
        .act = 2,
        .requires = .{ .energy = 1.8, .hours = 4.0, .food = 2.0, .fuel = 1.0, .tech = "granary" },
        .output = .{ .food = .{ .uniform = 5.0 } },
    },
    .{
        .id = "weave_cloth",
        .name = "Weave cloth",
        .act = 2,
        .requires = .{ .energy = 2.2, .hours = 6.0, .biomass = 2.0, .tech = "loom_ropewalk" },
        .output = .{ .food = .{ .normal = 1.0 } },
    },
    .{
        .id = "treat_illness",
        .name = "Treat illness",
        .act = 2,
        .requires = .{
            .energy = 1.5,
            .hours = 5.0,
            .food = 1.0,
            .water = 1.0,
            .tech = "sanitation",
        },
        .output = .{ .food = .{ .exponential = 1.0 } },
    },
    .{
        .id = "fire_pottery",
        .name = "Fire pottery",
        .act = 2,
        .requires = .{
            .energy = 2.0,
            .hours = 5.0,
            .fuel = 1.0,
            .minerals = 2.0,
            .tech = "pottery_works",
        },
        .output = .{ .minerals = .{ .uniform = 3.0 } },
    },
    .{
        .id = "haul_water",
        .name = "Haul water",
        .act = 2,
        .requires = .{ .energy = 2.6, .hours = 5.0, .biomass = 1.0, .tech = "well_cistern" },
        .output = .{ .water = .{ .normal = 6.0 } },
    },
    .{
        .id = "cut_peat",
        .name = "Cut peat",
        .act = 2,
        .requires = .{ .energy = 2.7, .hours = 6.0, .water = 1.0, .tech = "peat_works" },
        .output = .{ .fuel = .{ .poisson = 3.0 } },
    },
    .{
        .id = "forge_parts",
        .name = "Forge parts",
        .act = 2,
        .requires = .{ .energy = 3.0, .hours = 7.0, .fuel = 2.0, .metal = 2.0, .all = .{"forge"} },
        .output = .{ .metal = .{ .uniform = 3.0 } },
    },
    // Tend garden (the settlement's bed): the Act II garden bed's two-day crop.
    .{
        .id = "tend_garden_two",
        .name = "Tend garden",
        .act = 2,
        .generator = true,
        .requires = .{ .energy = 0.5, .hours = 48.0, .biomass = 0.2, .all = .{"garden_bed_two"} },
        .output = .{ .food = .{ .uniform = 3.0 } },

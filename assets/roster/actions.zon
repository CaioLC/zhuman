// The labor verbs. The grammar is described in
// `src/README.md` ("The authored roster"): `requires` is the body-and-time price, paid at
// begin; `input` is what the act consumes, paid at begin; `output` is what it draws at
// completion. A line's `kind` defaults to `.fixed` (exact); the other kinds draw, and the
// spread is the risk. Ids are plain and share one space with resources and goods. The order
// here is the ACTIONS surface's reading order.
.{
    // Forage: glean the greenbelt. The safe calorie baseline — normal, steady.
    .{
        .id = "forage",
        .name = "Forage",
        .requires = .{ .energy = 1.7, .hours = 4.0 },
        .output = .{
            .{ .item = "food", .n = 1.8, .kind = .normal },
        },
    },
    // Scavenge: pick through the derelict edge of town.
    // Mostly scraps, occasionally a jackpot find, and sometimes
    // a forgotten can of food. This is what bootstraps the first tool.
    .{
        .id = "scavenge",
        .name = "Scavenge",
        .requires = .{ .energy = 2.0, .hours = 5.0 },
        .output = .{
            .{ .item = "food", .n = 0.3, .kind = .exponential },
            .{ .item = "biomass", .n = 2.5, .kind = .exponential },
        },
    },
    // Split wood: unlocked by the hatchet — you cannot split logs bare-handed. Steady
    // Biomass (displayed as Materials in Act I); uniform, an even spread rather than a bell.
    .{
        .id = "chop_wood",
        .name = "Split wood",
        .requires = .{ .energy = 5.0, .hours = 5.0 },
        .output = .{
            .{ .item = "biomass", .n = 5.0, .kind = .uniform },
        },
    },
    // Fish: unlocked by the fishing rod. Better mean than Forage but poisson-lumpy — feast
    // or famine; wants a larder buffer under the metabolism.
    .{
        .id = "fish",
        .name = "Fish",
        .requires = .{ .energy = 2.0, .hours = 6.0 },
        .output = .{
            .{ .item = "food", .n = 3.0, .kind = .poisson },
        },
    },
    // Check traps: the wire snares' round, collected without occupying the body. Its cycle
    // accumulates while the snares are owned; collecting pays the energy and the bait and draws
    // the catch.
    .{
        .id = "check_traps",
        .name = "Check traps",
        .generator = true,
        .requires = .{ .energy = 1.0, .hours = 24.0 },
        .input = .{
            .{ .item = "biomass", .n = 1.0 },
        },
        .output = .{
            .{ .item = "food", .n = 3.0, .kind = .poisson },
        },
    },
    // Hunt: unlocked by the crude spear. It joins the Act I ACTIONS surface as soon as the
    // player owns one; before that the grant gate keeps the tile absent.
    .{
        .id = "hunt",
        .name = "Hunt",
        .requires = .{ .energy = 4.0, .hours = 8.0 },
        .input = .{
            .{ .item = "biomass", .n = 1.0 },
        },
        .output = .{
            .{ .item = "food", .n = 6.0, .kind = .poisson },
        },
    },

    // Tend garden: the garden bed's two-day crop, collected without occupying the body.
    .{
        .id = "tend_garden",
        .name = "Tend garden",
        .generator = true,
        .requires = .{ .energy = 0.5, .hours = 48.0 },
        .input = .{
            .{ .item = "biomass", .n = 0.2 },
        },
        .output = .{
            .{ .item = "food", .n = 1.0, .kind = .uniform },
        },
    },
    // Gather remedy: the medicinal herb bed's remedy, a direct restoration of vigor.
    .{
        .id = "gather_remedy",
        .name = "Gather remedy",
        .generator = true,
        .requires = .{ .energy = 0.25, .hours = 48.0 },
        .vigor = 1.5,
    },
    // Collect eggs: the chicken coop's daily lay.
    .{
        .id = "collect_eggs",
        .name = "Collect eggs",
        .generator = true,
        .requires = .{ .energy = 0.5, .hours = 24.0 },
        .input = .{
            .{ .item = "biomass", .n = 0.3 },
        },
        .output = .{
            .{ .item = "food", .n = 2.5, .kind = .poisson },
        },
    },

    // —— Act II population-scale actions (act = 2) ——————————————————————————————————————
    // The twenty verbs the settlement works at scale. The first five mirror the Act I labor
    // in the Act II resource space (the same Biomass stock sheds its Materials cover);
    // the rest are the broader production the research board opens. A verb is held through
    // the good that grants it (the firepit, the spring well, the forge) or through `tech`, the
    // technology that establishes it, once researched. Items name only the `Resource` enum —
    // tools/comfort/transport products settle into the nearest stock (metal for tooling, food
    // for comfort/care, biomass for carried freight). The order is the Act II ACTIONS
    // browser's authored order.
    .{
        .id = "draw_water",
        .name = "Draw water",
        .act = 2,
        .requires = .{ .energy = 1.2, .hours = 3.0 },
        .output = .{
            .{ .item = "water", .n = 4.0, .kind = .normal },
        },
    },
    .{
        .id = "tend_gardens",
        .name = "Tend gardens",
        .act = 2,
        .tech = "field_cultivation",
        .requires = .{ .energy = 1.5, .hours = 4.0 },
        .input = .{
            .{ .item = "water", .n = 1.0 },
        },
        .output = .{
            .{ .item = "food", .n = 4.0, .kind = .uniform },
        },
    },
    .{
        .id = "gather_clay",
        .name = "Gather clay",
        .act = 2,
        .tech = "quarry_pit",
        .requires = .{ .energy = 2.1, .hours = 5.0 },
        .input = .{
            .{ .item = "water", .n = 1.0 },
        },
        .output = .{
            .{ .item = "minerals", .n = 4.0, .kind = .normal },
        },
    },
    .{
        .id = "burn_charcoal",
        .name = "Burn charcoal",
        .act = 2,
        .requires = .{ .energy = 1.3, .hours = 7.0 },
        .input = .{
            .{ .item = "biomass", .n = 3.0 },
        },
        .output = .{
            .{ .item = "fuel", .n = 4.0, .kind = .uniform },
        },
    },
    .{
        .id = "quarry_stone",
        .name = "Quarry stone",
        .act = 2,
        .tech = "stoneworks",
        .requires = .{ .energy = 3.2, .hours = 6.0 },
        .output = .{
            .{ .item = "minerals", .n = 3.5, .kind = .poisson },
        },
    },
    .{
        .id = "repair_tools",
        .name = "Repair tools",
        .act = 2,
        .tech = "smithy",
        .requires = .{ .energy = 1.6, .hours = 3.0 },
        .input = .{
            .{ .item = "biomass", .n = 2.0 },
        },
        .output = .{
            .{ .item = "metal", .n = 1.0, .kind = .normal },
        },
    },
    .{
        .id = "carry_freight",
        .name = "Carry freight",
        .act = 2,
        .tech = "woodcutting",
        .requires = .{ .energy = 2.4, .hours = 5.0 },
        .input = .{
            .{ .item = "food", .n = 1.0 },
        },
        .output = .{
            .{ .item = "biomass", .n = 2.0, .kind = .uniform },
        },
    },
    .{
        .id = "fell_timber",
        .name = "Fell timber",
        .act = 2,
        .tech = "woodcutting",
        .requires = .{ .energy = 3.0, .hours = 6.0 },
        .output = .{
            .{ .item = "biomass", .n = 7.0, .kind = .normal },
        },
    },
    .{
        .id = "harvest_reeds",
        .name = "Harvest reeds",
        .act = 2,
        .tech = "loom_ropewalk",
        .requires = .{ .energy = 1.4, .hours = 4.0 },
        .input = .{
            .{ .item = "water", .n = 1.0 },
        },
        .output = .{
            .{ .item = "biomass", .n = 4.0, .kind = .exponential },
        },
    },
    .{
        .id = "smelt_ore",
        .name = "Smelt ore",
        .act = 2,
        .tech = "smelting_hearth",
        .requires = .{ .energy = 3.0, .hours = 6.0 },
        .input = .{
            .{ .item = "minerals", .n = 2.0 },
            .{ .item = "fuel", .n = 2.0 },
        },
        .output = .{
            .{ .item = "metal", .n = 2.0, .kind = .fixed },
        },
    },
    .{
        .id = "mine_ore",
        .name = "Mine ore",
        .act = 2,
        .tech = "surface_ore",
        .requires = .{ .energy = 3.5, .hours = 8.0 },
        .input = .{
            .{ .item = "metal", .n = 1.0 },
        },
        .output = .{
            .{ .item = "metal", .n = 2.0, .kind = .poisson },
        },
    },
    .{
        .id = "smelt_metal",
        .name = "Smelt metal",
        .act = 2,
        .tech = "iron_smelting",
        .requires = .{ .energy = 2.8, .hours = 7.0 },
        .input = .{
            .{ .item = "fuel", .n = 2.0 },
            .{ .item = "minerals", .n = 2.0 },
        },
        .output = .{
            .{ .item = "metal", .n = 3.0, .kind = .uniform },
        },
    },
    .{
        .id = "mill_grain",
        .name = "Mill grain",
        .act = 2,
        .tech = "water_wheel",
        .requires = .{ .energy = 2.0, .hours = 5.0 },
        .input = .{
            .{ .item = "food", .n = 2.0 },
        },
        .output = .{
            .{ .item = "food", .n = 5.0, .kind = .normal },

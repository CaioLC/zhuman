    },
    .{
        .id = "weave_cloth",
        .name = "Weave cloth",
        .act = 2,
        .tech = "loom_ropewalk",
        .requires = .{ .energy = 2.2, .hours = 6.0 },
        .input = .{
            .{ .item = "biomass", .n = 2.0 },
        },

    },
    .{
        .id = "bicycle",
        .name = "Bicycle",
        .tier = .manufactured,
        .requires = .{ .energy = 2.0, .hours = 140.0, .biomass = 280.0 },
        .effects = .{
            .{ .scale = .{ .target = "forage", .stat = .energy, .by = 0.6 } },
            .{ .scale = .{ .target = "scavenge", .stat = .energy, .by = 0.6 } },
        },
        .copy = .{
            .effect = "roaming costs less",

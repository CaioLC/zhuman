// The capital goods — recipes for the BUILD shelf, plus the tools only the passerby carries.
// The grammar is described in `src/README.md` ("The authored roster"). `requires` is the build
// cost — energy, hours and an amount of each resource, spent at begin — and its gates: a
// researched `tech`, `any` or `all` of a list of goods and verbs. A build yields one unit of the
// good. What owning a good does is its `effects`, from a fixed vocabulary; `family` + `rank` say
// which tool a better one supersedes. A good opens a verb by being named in that verb's gate
// (`assets/roster/actions.zon`). `copy` is the player's words.
//
// Crude goods are what one person can build in Act I. Manufactured unlockers are acquired
// from the passerby instead; the remaining manufactured records stay catalogued for later
// progression but never enter the Act I BUILD shelf.
.{
    // —— Manufactured unlockers: passerby-only in Act I ———————————————————————————————
    .{
        .id = "fish_rod",
        .name = "Fishing rod",
        .buildable = false,
        .family = .{ .name = "fishing", .rank = 1 },
        .copy = .{
            .effect = "you can fish",
            .short = "can fish",
            .built = "You built a fish rod. Fishing is now possible.",
        },
    },
    .{
        .id = "hatchet",
        .name = "Hatchet",
        .buildable = false,
        .family = .{ .name = "chopping", .rank = 1 },
        .copy = .{
            .effect = "you can split wood",
            .short = "can split wood",
            .built = "You built a hatchet. You can split wood now.",
        },
    },
    // Wire snares open Check traps, a round collected without occupying the body.
    .{
        .id = "wire_snares",
        .name = "Wire snares",
        .tier = .crude,
        .requires = .{ .energy = 2.0, .hours = 8.0, .biomass = 5.0 },
        .copy = .{
            .effect = "readies game to collect",
            .short = "traps game",
            .built = "You set wire snares. They will ready game without occupying you.",
        },
    },
    .{
        .id = "spear",
        .name = "Spear",
        .tier = .crude,
        .requires = .{ .energy = 5.0, .hours = 6.0, .biomass = 10.0 },
        .copy = .{
            .effect = "you can hunt",
            .short = "can hunt",
            .built = "A sharp, long stick. You can hunt now.",
        },
    },

    // —— Modifiers: a margin on a verb you already have ——————————————————————————————————
    .{
        .id = "sandals",
        .name = "Sandals",
        .tier = .crude,
        .requires = .{ .energy = 1.0, .hours = 6.0, .biomass = 3.0 },

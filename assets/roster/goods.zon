    },
    // The Act One capstone and the Act II teaser: the first substitution of external energy
    // for muscle. Splitting wood stops pricing the body and starts pricing fuel.
    .{
        .id = "chainsaw",
        .name = "Chainsaw",
        .tier = .manufactured,
        .requires = .{ .energy = 3.0, .hours = 300.0, .biomass = 480.0, .all = .{"chop_wood"} },
        .effects = .{
            .{ .scale = .{ .target = "chop_wood", .stat = .energy, .by = 0.3 } },
            .{ .add = .{ .target = "chop_wood", .stat = .{ .input = .biomass }, .by = 1.0 } },
            .{ .scale = .{ .target = "chop_wood", .stat = .{ .output = .biomass }, .by = 2.5 } },
        },
        .copy = .{
            .effect = "fuel does the work, not you",
            .short = "fuel does the work",
            .built = "You got a chainsaw running. The engine works, not your back.",
        },
    },

